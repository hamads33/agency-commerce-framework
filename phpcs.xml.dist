<?xml version="1.0"?>
<ruleset name="Agency Commerce">
	<description>WordPress Coding Standards for the agency-commerce framework.</description>

	<file>wp-content/plugins/agency-commerce-core</file>
	<file>wp-content/themes/agency-commerce</file>
	<file>wp-content/themes/agency-commerce-child</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibility"/>

	<config name="testVersion" value="8.2-"/>
</ruleset>
